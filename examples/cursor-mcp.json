{
  "mcpServers": {
    "withings": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/YpsilonTM/withings-mcp",
        "withings-mcp"
      ],
      "env": {
        "WITHINGS_CLIENT_ID": "your_client_id",
        "WITHINGS_CLIENT_SECRET": "your_client_secret",
        "WITHINGS_TOKEN_FILE": "/absolute/path/to/tokens.json",
        "WITHINGS_LOG_LEVEL": "info"
      }
    }
  }
}
